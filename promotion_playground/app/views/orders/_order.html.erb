<div id="<%= dom_id order %>">
  <p>
    <strong>Customer name:</strong>
    <%= order.customer_name %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= order.status %>
  </p>

  <p>
    <strong>Promotion:</strong>
    <%= order.promotion_id %>
  </p>

  <p>
    <strong>Subtotal cents:</strong>
    <%= order.subtotal_cents %>
  </p>

  <p>
    <strong>Discount cents:</strong>
    <%= order.discount_cents %>
  </p>

  <p>
    <strong>Total cents:</strong>
    <%= order.total_cents %>
  </p>

</div>
