<!DOCTYPE html>
<html lang="th">
  <head>
    <title>E-Commerce Promotion Playground</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <%= link_to "ข้ามไปยังเนื้อหาหลัก", "#main-content", class: "skip-link" %>

    <header class="site-header">
      <nav class="nav" aria-label="เมนูหลัก">
        <div class="nav-inner">
          <%= link_to root_path, class: "brand", aria: { label: "E-Commerce Playground — หน้าหลัก" } do %>
            <span class="brand-mark" aria-hidden="true">EC</span>
            <span class="brand-copy">
              <span class="brand-name">E-Commerce Playground</span>
              <span class="brand-tagline">Promotion Workshop</span>
            </span>
          <% end %>

          <div class="nav-links">
            <%= link_to "Products", products_path,
              class: "nav-link#{' active' if controller_name == 'products'}",
              aria: { current: ("page" if controller_name == "products") } %>
            <%= link_to "Promotions", promotions_path,
              class: "nav-link#{' active' if controller_name == 'promotions'}",
              aria: { current: ("page" if controller_name == "promotions") } %>
            <%= link_to "Orders", orders_path,
              class: "nav-link#{' active' if controller_name == 'orders'}",
              aria: { current: ("page" if controller_name == "orders") } %>
          </div>
        </div>
      </nav>
    </header>

    <main id="main-content" class="container main-container" tabindex="-1">
      <div class="flash-stack">
        <% flash.each do |type, message| %>
          <div class="flash <%= type %>" role="<%= type.to_s == 'notice' ? 'status' : 'alert' %>">
            <span><%= message %></span>
          </div>
        <% end %>
      </div>

      <%= yield %>
    </main>
  </body>
</html>